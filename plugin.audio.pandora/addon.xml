<?xml version="1.0" encoding="UTF-8"?>
<addon id="plugin.audio.pandora" version="3.0.0" name="Pandora Player" provider-name="Standalone">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>audio</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login"></extension>
  <extension point="xbmc.addon.metadata">
    <summary>Play Pandora stations in Kodi</summary>
    <description>Listen to your Pandora stations directly in Kodi</description>
  </extension>
</addon>
